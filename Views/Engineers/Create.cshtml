@model CMMS.Models.Engineer

<h1 style="background-color:lightgray; color:darkslategray">Create:</h1>

<form method="post" asp-controller="Engineers" asp-action="Create">
    <div class="row">
        <label asp-for="EngFullName" class="col-5"></label>
        <input asp-for="EngFullName" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="EngFullName"></span>
    </div>

    <div class="row">
        <label asp-for="DepartmentId" class="col-5"></label>
        <select asp-for="DepartmentId" asp-items="@(new SelectList(ViewBag.AllDepartments, "DeptId", "DepartmentName"))" class="col-4 form-control">

            <option disabled selected>select a Department....</option>

        </select>
        <span class="text-danger" asp-validation-for="DepartmentId"></span>
    </div>

    <div class="row">
        <label asp-for="EngEmail" class="col-5"></label>
        <input asp-for="EngEmail" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="EngEmail"></span>
    </div>

    <div class="row">
        <label asp-for="EngConfirmEmaill" class="col-5"></label>
        <input asp-for="EngConfirmEmaill" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="EngConfirmEmaill"></span>
    </div>

    <div class="row">
        <label asp-for="EngPhoneNo" class="col-5"></label>
        <input asp-for="EngPhoneNo" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="EngPhoneNo"></span>
    </div>

    <button type="submit" class="btn btn-primary">save</button>
    <hr />
    <a asp-controller="Engineers" asp-action="index"><i class="fas fa-undo-alt"></i></a>
    <br />
    <div asp-validation-summary="All"></div>


</form>