@model CMMS.Models.Engineer

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Engineer</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EngFullName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EngFullName)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EngEmail)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EngEmail)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EngPhoneNo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EngPhoneNo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Department)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Department.DedpartmentDescription)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.EngId"><i class="far fa-edit"></i></a> |
    <a asp-action="Index"><i class="fas fa-undo-alt"></i></a>
</div>
