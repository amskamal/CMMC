@model CMMS.Models.Equipment

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Equipment</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EqSerialNo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EqSerialNo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EqName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EqName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EqInstallatonDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EqInstallatonDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EqQuantity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EqQuantity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EqCost)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EqCost)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EqWarrantyDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EqWarrantyDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EqCurrentStatus)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EqCurrentStatus)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Vendor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Vendor.VendorFullName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Department)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Department.DepartmentName) | @Html.DisplayFor(Model => Model.Department.DedpartmentDescription)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.EqId"><i class="far fa-edit"></i></a> |
    <a asp-action="Index"><i class="fas fa-undo-alt"></i></a>
</div>
