@model CMMS.Models.Inventory

<h1 style="background-color:lightgray; color:darkslategray">Create:</h1>

<form method="post" asp-controller="Inventories" asp-action="Create">

    <div class="row">
        <label asp-for="EquipmentId" class="col-5"></label>
        <select asp-for="EquipmentId" asp-items="@(new SelectList(ViewBag.AllEquipments, "EqId", "EqName"))" class="col-4 form-control">

            <option disabled selected>select the Equipment....</option>

        </select>
        <span class="text-danger" asp-validation-for="EquipmentId"></span>
    </div>

    <button type="submit" class="btn btn-primary">save</button>
    <hr />
    <a asp-controller="Inventories" asp-action="index"><i class="fas fa-undo-alt"></i></a>
    <br />
    <div asp-validation-summary="All"></div>


</form>
