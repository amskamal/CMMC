@model CMMS.Models.Maintenance

<h1 style="background-color:lightgray; color:darkslategray">Create:</h1>

<form method="post" asp-controller="Maintenances" asp-action="Create">

    <div class="row">
        <label asp-for="EquipmentId" class="col-5"></label>
        <select asp-for="EquipmentId" asp-items="@(new SelectList(ViewBag.AllEquipments, "EqId", "EqName"))" class="col-4 form-control">

            <option disabled selected>select the Equipment....</option>

        </select>
        <span class="text-danger" asp-validation-for="EquipmentId"></span>
    </div>

    <div class="row">
        <label asp-for="MaintenaceDoneOn" class="col-5"></label>
        <input asp-for="MaintenaceDoneOn" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="MaintenaceDoneOn"></span>
    </div>

    <div class="row">
        <label asp-for="MaintenaceDueOn" class="col-5"></label>
        <input asp-for="MaintenaceDueOn" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="MaintenaceDueOn"></span>
    </div>

    <div class="row">
        <label asp-for="EngineerId" class="col-5"></label>
        <select asp-for="EngineerId" asp-items="@(new SelectList(ViewBag.AllEngineers, "EngId", "EngFullName"))" class="col-4 form-control">

            <option disabled selected>select a Engineer....</option>

        </select>
        <span class="text-danger" asp-validation-for="EngineerId"></span>
    </div>

    <div class="row">
        <label asp-for="EngRemarks" class="col-5"></label>
        <input asp-for="EngRemarks" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="EngRemarks"></span>
    </div>

    <div class="row">
        <label asp-for="UId" class="col-5"></label>
        <select asp-for="UId" asp-items="@(new SelectList(ViewBag.AllUsers, "UserId", "UserFullName"))" class="col-4 form-control">

            <option disabled selected>select a User....</option>

        </select>
        <span class="text-danger" asp-validation-for="UId"></span>
    </div>


    <div class="row">
        <label asp-for="UserRemarks" class="col-5"></label>
        <input asp-for="UserRemarks" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="UserRemarks"></span>
    </div>

    <div class="row">
        <label asp-for="BreakDownDate" class="col-5"></label>
        <input asp-for="BreakDownDate" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="BreakDownDate"></span>
    </div>

    <div class="row">
        <label asp-for="BreakDownDetails" class="col-5"></label>
        <input asp-for="BreakDownDetails" class="col-4 form-control" />
        <span class="text-danger" asp-validation-for="BreakDownDetails"></span>
    </div>

    <button type="submit" class="btn btn-primary">save</button>
    <hr />
    <a asp-controller="Maintenances" asp-action="index"><i class="fas fa-undo-alt"></i></a>
    <br />
    <div asp-validation-summary="All"></div>


</form>